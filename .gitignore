# ================================================================
#  AeroSniffer .gitignore
# ================================================================

# ── Secret / personal config ────────────────────────────────────
# Config.h contains WiFi credentials — DO NOT commit your version.
# The template version (with placeholder values) is tracked.
# After cloning, edit Config.h locally. It won't be re-tracked.
# Uncomment the line below only after your first commit of Config.h:
# MultiBoot_DeskGadget/Config.h
credentials.json

# ── Arduino build output ─────────────────────────────────────────
build/
*.elf
*.bin
*.hex
*.map
*.lst

# ── Arduino CLI binary (local testing) ──────────────────────────
bin/

# ── Arduino IDE temp files ───────────────────────────────────────
*.bak
~*.tmp
*.tmp

# ── PlatformIO (if you switch build systems later) ───────────────
.pio/
.pioenvs/
.piolibdeps/

# ── VS Code ──────────────────────────────────────────────────────
.vscode/
*.code-workspace

# ── macOS ────────────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# ── Windows ──────────────────────────────────────────────────────
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ── Linux ────────────────────────────────────────────────────────
*~
.nfs*

# ── Python (tools scripts) ───────────────────────────────────────
__pycache__/
*.pyc
*.pyo
.env
venv/

# ── Logs ─────────────────────────────────────────────────────────
*.log
serial_output.txt

# ── Generated animation headers (large — regenerate with gif2cpp) ─
# Uncomment if you don't want to track generated bitmap arrays:
# MultiBoot_DeskGadget/animations/

# ── IDE project files ─────────────────────────────────────────────
*.suo
*.user
*.sdf
.idea/

# ── Docs ─────────────────────────────────────────────────────────
docs/*
!docs/V2.6_*.md
!docs/TESTING/

# ── Local AI CLI assistant ──────────────────────────────────────
aerosniffer-ai.py
.aerosniffer-ai-history
.aerosniffer-ai-cache/
.opencode/

# Understand Anything knowledge graph output
UNDERSTAND/

